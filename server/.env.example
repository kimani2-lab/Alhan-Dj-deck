PORT=5000
FRONTEND_URL=https://alhan-dj-deck-kimani2-labs-projects.vercel.app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional yt-dlp tuning for cloud hosts (Render, Railway, VPS).
# A JavaScript runtime helps yt-dlp solve YouTube challenges (Docker image sets this to "node").
# YT_DLP_JS_RUNTIME=node
# Recommended on datacenter IPs that hit "Sign in to confirm you're not a bot":
# export your signed-in YouTube cookies in Netscape format, then either
# point to the file or paste it (raw or base64-encoded) into the variable.
# YT_DLP_COOKIES_FILE=/path/to/cookies.txt
# YT_DLP_COOKIES=
